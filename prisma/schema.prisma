generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String      @id @default(uuid())
  email        String      @unique
  phone        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  verified     Boolean     @default(false)
  role         Role        @default(PARTICIPANT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  organizer    Organizer?
  pendingOtp   PendingOtp?
  student      Student?
  curator      curator?
}

model Organizer {
  id                 String             @id @default(uuid())
  userId             String?            @unique
  company            String
  ownerName          String
  email              String
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionPlan   String             @default("Сынақ мерзімі")
  monthlyFee         Int                @default(0)
  nextPaymentDate    DateTime?
  createdAt          DateTime           @default(now())
  chatMessages       ChatMessage[]
  invitations        Invitation[]
  marathons          Marathon[]
  user               User?              @relation(fields: [userId], references: [id])
  curators           curator[]
}

model Marathon {
  id            String         @id @default(uuid())
  title         String
  description   String?
  durationDays  Int            @default(21)
  startDate     DateTime
  status        MarathonStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  organizerId   String
  announcements Announcement[]
  groups        Group[]
  invitations   Invitation[]
  organizer     Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  students      Student[]
  tasks         Task[]
  curators      curator[]      @relation("MarathonTocurator")
}

model Group {
  id            String         @id @default(uuid())
  name          String
  maxSize       Int            @default(30)
  createdAt     DateTime       @default(now())
  marathonId    String
  curatorId     String?        @unique
  announcements Announcement[]
  curator       curator?       @relation(fields: [curatorId], references: [id])
  marathon      Marathon       @relation(fields: [marathonId], references: [id], onDelete: Cascade)
  students      Student[]
}

model curator {
  id          String     @id @default(uuid())
  userId      String?    @unique
  name        String
  email       String
  phone       String
  createdAt   DateTime   @default(now())
  organizerId String
  group       Group?
  students    Student[]
  organizer   Organizer  @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id])
  marathons   Marathon[] @relation("MarathonTocurator")
}

model Student {
  id               String        @id @default(uuid())
  userId           String?       @unique
  name             String
  email            String
  phone            String?
  targetUniversity String?       @default("КБТУ")
  targetMajor      String?       @default("ВТиПО")
  targetScore      Int?          @default(135)
  points           Int           @default(0)
  status           StudentStatus @default(ACTIVE)
  joinedAt         DateTime      @default(now())
  marathonId       String
  groupId          String?
  curatorId        String?
  chatMessages     ChatMessage[]
  habits           Habit[]
  matrixTasks      MatrixTask[]
  curator          curator?      @relation(fields: [curatorId], references: [id])
  group            Group?        @relation(fields: [groupId], references: [id])
  marathon         Marathon      @relation(fields: [marathonId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id])
  submissions      Submission[]
  managerId     String?  // 👈 Осы жолды қосыңыз
  paymentStatus String?  @default("PAID") // 👈 Осы жолды қосыңыз

  @@index([marathonId])
  @@index([curatorId])
  @@index([groupId])
  
}

model Task {
  id               String           @id @default(uuid())
  dayNumber        Int
  title            String
  videoUrl         String?
  content          String?
  fileUrls         String[]
  points           Int              @default(10)
  verificationType VerificationType @default(TEST)
  status           TaskStatus       @default(DRAFT)
  createdAt        DateTime         @default(now())
  marathonId       String
  submissions      Submission[]
  marathon         Marathon         @relation(fields: [marathonId], references: [id], onDelete: Cascade)

  @@index([marathonId])
}

model Submission {
  id          String           @id @default(uuid())
  dayNumber   Int
  status      SubmissionStatus @default(PENDING)
  checklist   Json             @default("{\"video\": false, \"routine\": false, \"homework\": false}")
  fileUrl     String?
  submittedAt DateTime?
  studentId   String
  taskId      String?
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([taskId])
}

model Invitation {
  id              String         @id @default(uuid())
  role            InvitationRole
  fullName        String
  phone           String
  email           String
  status          InviteStatus   @default(PENDING)
  claimedByUserId String?
  createdAt       DateTime       @default(now())
  marathonId      String
  organizerId     String
  marathon        Marathon       @relation(fields: [marathonId], references: [id], onDelete: Cascade)
  organizer       Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
}

model Habit {
  id        String   @id @default(uuid())
  title     String
  doneDates Json     @default("[]")
  createdAt DateTime @default(now())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model MatrixTask {
  id        String   @id @default(uuid())
  title     String
  urgent    Boolean  @default(false)
  important Boolean  @default(false)
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id          String    @id @default(uuid())
  studentName String
  text        String
  createdAt   DateTime  @default(now())
  organizerId String
  studentId   String?
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id])
}

model PendingOtp {
  id        String   @id @default(uuid())
  code      String
  phone     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String
  authorRole String
  authorName String
  marathonId String
  groupId    String?
  createdAt  DateTime @default(now())
  group      Group?   @relation(fields: [groupId], references: [id])
  marathon   Marathon @relation(fields: [marathonId], references: [id], onDelete: Cascade)
}

enum Role {
  OWNER
  ORGANIZER
  MANAGER     // 👈 Менеджер (Оқушы қосу, сату, төлемдер)
  TEACHER     // 👈 Мұғалім (Тапсырмалар, контент, сабақтар)
  BASCURATOR  // 👈 Бас куратор (Кураторлар мен топтарды бақылау)
  CURATOR
  PARTICIPANT
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  BLOCKED
}

enum MarathonStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum StudentStatus {
  ACTIVE
  BLOCKED
}

enum VerificationType {
  TEST
  SCREENSHOT
}

enum TaskStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  MISSED
}

enum InvitationRole {
  STUDENT
  curator
}

enum InviteStatus {
  PENDING
  CLAIMED
}
