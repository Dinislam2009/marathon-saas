generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String      @id @default(uuid())
  email           String      @unique
  phone           String      @unique
  passwordHash    String
  firstName       String      
  lastName        String      
  verified        Boolean     @default(false)
  role            Role        @default(PARTICIPANT)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // 1. Ұйымға мүшелік (Команда мүшесі)
  organizerId     String?
  organizer       Organizer?  @relation("OrganizationUsers", fields: [organizerId], references: [id])

  // 2. Өзі ашқан ұйым (Иесі)
  ownedOrganizer  Organizer?  @relation("OrganizerOwner")

  pendingOtp      PendingOtp?
  student         Student?
  curator         Curator?
  managedStudents Student[]   @relation("ManagerToStudent")

  @@index([role])
}

model Organizer {
  id                 String             @id @default(uuid())
  userId             String?            @unique
  company            String
  ownerName          String
  email              String
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  subscriptionPlan   String             @default("Сынақ мерзімі")
  maxMarathons       Int                @default(2)   // 👈 ҚОСУ КЕРЕК
  maxStudents        Int                @default(50)  // 👈 ҚОСУ КЕРЕК
  monthlyFee         Int                @default(0)
  nextPaymentDate    DateTime?
  createdAt          DateTime           @default(now())

  chatMessages       ChatMessage[]
  invitations        Invitation[]
  marathons          Marathon[]

  // 1. Ұйым иесі (Owner)
  user               User?              @relation("OrganizerOwner", fields: [userId], references: [id])

  // 2. Ұйымға тіркелген барлық пайдаланушылар
  users              User[]             @relation("OrganizationUsers")

  curators           Curator[]
}

model Marathon {
  id            String         @id @default(uuid())
  title         String
  description   String?
  durationDays  Int            @default(21)
  startDate     DateTime
  status        MarathonStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  organizerId   String

  announcements Announcement[]
  groups        Group[]
  invitations   Invitation[]
  organizer     Organizer      @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  students      Student[]
  tasks         Task[]
  curators      Curator[]      @relation("MarathonToCurator")

  @@index([organizerId])
}

// The remainder of the legacy schema is intentionally preserved by the repository.
// This change only removes Prisma 7-incompatible datasource URL fields.
