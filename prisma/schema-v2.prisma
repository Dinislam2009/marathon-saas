// Loopit 2.0 — Education Business OS target schema
// This schema is generated into an isolated V2 Prisma client.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-v2"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  MANAGER
  TEACHER
  CURATOR
  ACCOUNTANT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ProgramType {
  COURSE
  EXAM_PREP
  MARATHON
  INTENSIVE
  CLUB
  OTHER
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GroupStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  REVIEWED
  RETURNED
  LATE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  TRIAL
  NEGOTIATION
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model Organization {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  logoUrl     String?
  phone       String?
  email       String?
  address     String?
  timezone    String             @default("Asia/Almaty")
  currency    String             @default("KZT")
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  memberships   OrganizationMembership[]
  invitations   OrganizationInvitation[]
  students      Student[]
  programs      Program[]
  courses       Course[]
  groups        Group[]
  leads         Lead[]
  deals         Deal[]
  invoices      Invoice[]
  payments      Payment[]
  notifications Notification[]
  messages      Message[]
  activities    Activity[]
  auditLogs     AuditLog[]
  announcements Announcement[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  phone        String?      @unique
  passwordHash String
  firstName    String
  lastName     String
  avatarUrl    String?
  status       UserStatus   @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  memberships        OrganizationMembership[]
  sentInvitations    OrganizationInvitation[] @relation("InvitationSender")
  acceptedInvitations OrganizationInvitation[] @relation("InvitationAcceptor")
  taughtGroups       Group[]                  @relation("GroupTeacher")
  createdLeads       Lead[]                   @relation("LeadOwner")
  createdDeals       Deal[]                   @relation("DealOwner")
  sentNotifications  Notification[]           @relation("NotificationRecipient")
  activities         Activity[]
  auditLogs          AuditLog[]
  announcements      Announcement[]            @relation("AnnouncementAuthor")
  messagesSent       Message[]                 @relation("MessageSender")
}

model OrganizationMembership {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
}

model OrganizationInvitation {
  id              String           @id @default(cuid())
  organizationId  String
  invitedByUserId String
  acceptedByUserId String?
  email           String
  role            MembershipRole
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedByUser  User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedByUser User?        @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@index([expiresAt])
}

model Student {
  id             String     @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String
  phone          String?
  email          String?
  dateOfBirth    DateTime?
  status         UserStatus @default(ACTIVE)
  source         String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  attendances  Attendance[]
  submissions  HomeworkSubmission[]
  leads        Lead[]
  invoices     Invoice[]
  payments     Payment[]
  messages     Message[]
  parentLinks  ParentStudent[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model Parent {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentLinks ParentStudent[]
}

model ParentStudent {
  parentId  String
  studentId String
  relation  String?

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model Program {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  description    String?
  type           ProgramType   @default(COURSE)
  status         ProgramStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courses       Course[]
  enrollments   Enrollment[]