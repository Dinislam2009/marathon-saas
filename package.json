{
  "name": "marathon-saas",
  "version": "0.1.0",
  "private": true,
  "description": "Marafon/intensivter uyymdastyruğa arnalğan köpqoldanuşyly (multi-tenant) SaaS platforması",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:generate && npm run prisma:v2:generate && next build",
    "start": "next start",
    "lint": "next lint",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:v2:validate": "prisma validate --schema=prisma/schema-v2.prisma",
    "prisma:v2:generate": "prisma generate --schema=prisma/schema-v2.prisma",
    "test:v2:core-schema": "node scripts/validate-loopit-v2-schema.mjs",
    "test:v2:postgres": "node scripts/test-v2-postgres.mjs",
    "test:v2:course-api": "node --experimental-strip-types --test scripts/test-v2-course-api-contracts.mts",
    "typecheck": "npm run prisma:generate && npm run prisma:v2:generate && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@supabase/supabase-js": "^2.110.8",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^1.24.0",
    "next": "^16.2.7",
    "pg": "^8.22.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "prisma": "7.8.0",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
